<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Only what the app uses today (audit B14). Each new on-device power (notifications, location, contacts, mic,
      photos) is added WITH the code and the runtime request that uses it, not before.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Site reads the phone's fix and posts it to the record (runtime request in HubSiteScreens / HomeScreen; LocationReader) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Where he is with the app closed: one fix every 15 minutes (LocationSync, 0.7.3). His "Allow all the time" tap in Android's settings -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lets him tell Android not to put the app to sleep, so the 15-minute job keeps running (sideload build; Android's own dialog) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Photo Documentation takes pictures (runtime request in PhotoDocumentationScreen) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Call recordings sync (runtime request in CarolineOfficeScreens; RecordingsSync). READ_EXTERNAL_STORAGE is its API <= 32 form -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Call log sync (runtime request in CarolineOfficeScreens; CallLogSync) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- OTA self-update: install a downloaded update APK (sideload builds only; Play does not allow it - see B13) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".ConstructionManagerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConstructionManager"
        tools:targetApi="31">
        
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ConstructionManager"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves downloaded update APKs to the platform installer (OTA self-update) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>