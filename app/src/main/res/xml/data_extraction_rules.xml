<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup (the -wal / -shm files too: audit B17) -->
        <exclude domain="database" path="construction_manager_database" />
        <exclude domain="database" path="construction_manager_database-wal" />
        <exclude domain="database" path="construction_manager_database-shm" />
        <!-- This phone's Caroline device token and unsent messages -->
        <exclude domain="sharedpref" path="caroline_connector.xml" />
        <exclude domain="sharedpref" path="construction_manager_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="construction_manager_database" />
        <exclude domain="database" path="construction_manager_database-wal" />
        <exclude domain="database" path="construction_manager_database-shm" />
        <exclude domain="sharedpref" path="caroline_connector.xml" />
        <exclude domain="sharedpref" path="construction_manager_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
