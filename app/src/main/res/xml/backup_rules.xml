<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive data from backup. The -wal / -shm files hold recent database pages too (audit B17). -->
    <exclude domain="database" path="construction_manager_database" />
    <exclude domain="database" path="construction_manager_database-wal" />
    <exclude domain="database" path="construction_manager_database-shm" />
    <!-- This phone's Caroline device token and unsent messages: never restored onto another phone. -->
    <exclude domain="sharedpref" path="caroline_connector.xml" />
</full-backup-content>
